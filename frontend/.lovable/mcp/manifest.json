{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://lqxgdvchxtblbbfyalhj.supabase.co/auth/v1",
    "accepted_audiences": ["authenticated"]
  },
  "mcp": {
    "server": {
      "name": "huomaa-hyva-mcp",
      "version": "0.1.0",
      "title": "Huomaa Hyvä — Vahvuusseikkailu"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Return the signed-in user's id, email, display name and role (student or teacher) in the Huomaa Hyvä workbook.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_my_progress",
        "title": "Get my progress",
        "description": "Return the signed-in student's current screen number and the count of workbook fields they have filled in so far.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_responses",
        "title": "List my responses",
        "description": "List the signed-in student's saved workbook responses (field_key + value). Optionally filter by a field_key prefix (e.g. a screen id like 's14').",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "prefix": {
              "description": "Optional field_key prefix to filter by, e.g. 's14'.",
              "type": "string",
              "maxLength": 64
            },
            "limit": {
              "description": "Max rows to return (default 200).",
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_my_classes",
        "title": "List my classes",
        "description": "For a signed-in teacher: list the classes they own, with join codes and the number of enrolled students.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_class_students",
        "title": "List class students",
        "description": "For a signed-in teacher: list students enrolled in one of their classes, with display name, current screen, and number of saved fields.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "class_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The id of a class the signed-in teacher owns."
            }
          },
          "required": ["class_id"]
        },
        "outputSchema": null
      }
    ]
  }
}
