# ============================================================
# Vahvuusseikkailu — environment variables
# Copy to .env (local dev) and configure on your host (Vercel/Netlify/etc).
# ============================================================

# ---- Client-visible (Vite injects these into the browser bundle) ----
# Safe to expose; protected by Row-Level Security on the database.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx_or_legacy_anon_jwt"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# ---- Server-only (used by TanStack Start server functions / SSR) ----
# Mirror of the values above; NOT prefixed with VITE_ so they don't leak.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx_or_legacy_anon_jwt"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# ---- Strictly server-only — NEVER expose to the browser ----
# Only required if you add admin / privileged server functions.
# The shipped app does not require it for normal student/teacher flows.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...service-role-key..."
